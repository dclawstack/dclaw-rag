<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Hardened-runtime entitlements for notarization. DClaw RAG bootstraps a private
    Python runtime and runs native ML libraries (sentence-transformers, faster-whisper,
    llama.cpp) that JIT and load unsigned .so/.dylib files, so the following are required
    or the child process is killed by the hardened runtime.
  -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <!-- Voice queries record from the microphone. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- Local-first, but the first run downloads the runtime + models. -->
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
