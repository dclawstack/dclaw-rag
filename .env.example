# App
APP_ENV=dev
LOG_LEVEL=INFO
# APP_MODE=local runs everything in one process with no external services:
# SQLite KV + embedded Qdrant under DATA_DIR, inline ingestion, rate limiting
# off, embeddings default to bge-small-en-v1.5, API key sk_local is seeded
# (point the frontend's NEXT_PUBLIC_API_KEY at it). See DEPLOY.md "Local mode".
APP_MODE=server
DATA_DIR=~/.dclaw-rag

# Encryption at rest for local-mode state (needs the 'encryption' extra:
# pip install -e '.[encryption]'). Off by default; server deployments rely on
# infra disk encryption. When on, the SQLite KV is whole-DB SQLCipher-encrypted
# (covers key names like emails) and Qdrant chunk text is Fernet-encrypted.
# Set ENCRYPTION_KEY to a passphrase, OR ENCRYPTION_KEY_FILE=true to auto-generate
# one at DATA_DIR/encryption.key (0600). Enabling on an existing plaintext store
# needs a fresh store; LOSING THE KEY LOSES THE DATA.
# ENCRYPTION_KEY=
ENCRYPTION_KEY_FILE=false

# API
API_HOST=0.0.0.0
API_PORT=8090
# CORS: comma/JSON list of allowed browser origins
CORS_ALLOW_ORIGINS=["http://localhost:3003"]

# Abuse / resource limits
RATE_LIMIT_PER_MINUTE=60          # per tenant, on query/agent/ingest; 0 disables
AUTH_RATE_LIMIT_PER_MINUTE=10     # per client IP, on register/login; 0 disables
MAX_UPLOAD_BYTES=10485760         # 10 MiB per uploaded file
MAX_REQUEST_BYTES=12582912        # 12 MiB global request body cap

# Auth (API key -> tenant). BOOTSTRAP_API_KEY is seeded on startup and used by
# the dev frontend — set the frontend's NEXT_PUBLIC_API_KEY to the same value.
# ADMIN_API_KEY is required to mint tenant keys via POST /api/v1/rag/keys.
BOOTSTRAP_API_KEY=sk_dev_bootstrap
BOOTSTRAP_TENANT=default
ADMIN_API_KEY=sk_admin_dev

# End-user login (email+password -> JWT). JWT_SECRET signs access tokens —
# MUST be a strong, unique value in production (>=32 chars; the prod config
# check rejects the dev default).
JWT_SECRET=dev-insecure-jwt-secret-change-me
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30   # short-lived, stateless
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30     # long-lived, revocable (stored in Redis)

# Speech-to-text (audio ingestion + voice queries; faster-whisper size/id,
# lazy-loaded on first use)
WHISPER_MODEL=base

# Embeddings
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# Vector Store
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=dclaw_docs
QDRANT_API_KEY=

# LLM (provider: openai | anthropic | openrouter | ollama | local)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Pricing for per-tenant usage/cost metering (USD per 1K tokens; set for your model)
LLM_PRICE_PER_1K_INPUT_USD=0.003
LLM_PRICE_PER_1K_OUTPUT_USD=0.015

# OpenRouter (OpenAI-compatible; set LLM_PROVIDER=openrouter to use)
# OPENROUTER_MODEL must be a CURRENT id from https://openrouter.ai/models
# (e.g. openai/gpt-4o-mini, anthropic/claude-sonnet-4.5, google/gemini-flash-1.5).
# Retired ids (e.g. anthropic/claude-3.5-sonnet) 404 — and the request then
# silently falls back to local Ollama. Watch for the "llm_primary_failed_using_fallback" log.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Local LLM fallback (used when the cloud provider fails)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
LLM_FALLBACK_TO_OLLAMA=true

# Bundled local LLM (LLM_PROVIDER=local): in-process llama.cpp GGUF, no daemon,
# no network at inference. Needs the 'local-llm' extra (pip install -e '.[local-llm]').
# The GGUF is downloaded from Hugging Face once (cached under DATA_DIR/models)
# unless LOCAL_LLM_MODEL_PATH points at an existing .gguf file.
LOCAL_LLM_MODEL_REPO=bartowski/Qwen2.5-3B-Instruct-GGUF
LOCAL_LLM_MODEL_FILE=Qwen2.5-3B-Instruct-Q4_K_M.gguf
# LOCAL_LLM_MODEL_PATH=/path/to/model.gguf
LOCAL_LLM_N_CTX=4096
# LOCAL_LLM_N_THREADS=
LOCAL_LLM_MAX_TOKENS=2048

# Reranker
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_TOP_K=10

# Retrieval quality (E2)
# Prepend document context to each chunk before embedding (recall win, no LLM).
# Affects newly-ingested docs only; stored text is unchanged.
CONTEXTUAL_RETRIEVAL=true
# On a weak first search, reformulate the query once with the LLM and re-search
# before answering/abstaining. Fires when the top rerank score < threshold.
SELF_CORRECT_RETRIEVAL=true
SELF_CORRECT_THRESHOLD=0.5
# /agent: reflect on gathered evidence and issue follow-up searches (within the
# request's max_steps budget) before synthesizing.
AGENTIC_REFLECTION=true

# Visual-document ingestion (E3, needs the 'vision' extra + system tesseract:
# pip install -e '.[vision]'). All lazy. Pull tables out of PDFs; OCR scanned
# PDFs (little/no extractable text) and image uploads.
EXTRACT_TABLES=true
OCR_SCANNED_PDFS=true
OCR_MIN_CHARS=100   # below this many extracted chars, a PDF is treated as scanned

# Trust & observability (E4)
STALE_AFTER_DAYS=365       # flag retrieved sources older than this many days; 0 disables
FLAG_CONTRADICTIONS=true   # LLM-check retrieved sources for contradictions (1 call when >=2 sources)

# Cache / Queue
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
QUERY_CACHE_TTL_SECONDS=300   # per-tenant query response cache; 0 disables
