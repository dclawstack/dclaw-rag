# App
APP_ENV=dev
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8090
# CORS: comma/JSON list of allowed browser origins
CORS_ALLOW_ORIGINS=["http://localhost:3003"]

# Auth (API key -> tenant). BOOTSTRAP_API_KEY is seeded on startup and used by
# the dev frontend — set the frontend's NEXT_PUBLIC_API_KEY to the same value.
# ADMIN_API_KEY is required to mint tenant keys via POST /api/v1/rag/keys.
BOOTSTRAP_API_KEY=sk_dev_bootstrap
BOOTSTRAP_TENANT=default
ADMIN_API_KEY=sk_admin_dev

# Embeddings
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# Vector Store
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=dclaw_docs
QDRANT_API_KEY=

# LLM (provider: openai | anthropic | openrouter | ollama)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# OpenRouter (OpenAI-compatible; set LLM_PROVIDER=openrouter to use)
# OPENROUTER_MODEL must be a CURRENT id from https://openrouter.ai/models
# (e.g. openai/gpt-4o-mini, anthropic/claude-sonnet-4.5, google/gemini-flash-1.5).
# Retired ids (e.g. anthropic/claude-3.5-sonnet) 404 — and the request then
# silently falls back to local Ollama. Watch for the "llm_primary_failed_using_fallback" log.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Local LLM fallback (used when the cloud provider fails)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
LLM_FALLBACK_TO_OLLAMA=true

# Reranker
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_TOP_K=10

# Cache / Queue
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
